// ==================== WIFI FUNCTIONS ====================
void connectToWiFi() {
  WiFi.disconnect();
  delay(1000);
  WiFi.mode(WIFI_STA);
  delay(1000);
  
  Serial.println("🔌 WiFi Connection Attempt:");
  Serial.println("   SSID: " + String(ssid));
  
  int n = WiFi.scanNetworks();
  Serial.println("🔍 Found " + String(n) + " networks");
  
  bool ssidFound = false;
  for (int i = 0; i < n; ++i) {
    if (WiFi.SSID(i) == ssid) {
      Serial.println("✅ Target network found: " + String(WiFi.RSSI(i)) + "dBm");
      ssidFound = true;
      break;
    }
  }
  
  if (!ssidFound) {
    Serial.println("❌ Target SSID not found!");
    wifiConnected = false;
    return;
  }
  
  WiFi.begin(ssid, password);
  Serial.print("🔌 Connecting");
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    wifiConnected = true;
    Serial.println();
    Serial.println("✅ WiFi Connected!");
    Serial.println("📶 IP: " + WiFi.localIP().toString());
    Serial.println("📶 Signal: " + String(WiFi.RSSI()) + " dBm");
  } else {
    Serial.println("\n❌ WiFi Failed!");
    wifiConnected = false;
  }
}

void checkWiFiConnection() {
  if (WiFi.status() != WL_CONNECTED && wifiConnected) {
    Serial.println("📶 WiFi lost! Reconnecting...");
    wifiConnected = false;
    connectToWiFi();
  } else if (WiFi.status() == WL_CONNECTED) {
    wifiConnected = true;
  }
}

// ==================== GPS FUNCTIONS ====================
void readGPS() {
  bool newData = false;
  
  while (SerialGPS.available() > 0) {
    if (gps.encode(SerialGPS.read())) {
      newData = true;
    }
  }
  
  if (newData && gps.location.isValid()) {
    latitude = gps.location.lat();
    longitude = gps.location.lng();
    gpsConnected = true;
    gpsFixed = true;
    
    if (gps.altitude.isValid()) {
      altitude_m = gps.altitude.meters();
    }
    if (gps.satellites.isValid()) {
      satellites = gps.satellites.value();
    }
  } else if (millis() > 15000 && gps.charsProcessed() < 10) {
    gpsConnected = false;
    gpsFixed = false;
  }
}

// ==================== ULTRA-ACCURATE SENSOR FUNCTIONS ====================
void calibrateSensor() {
  Serial.println("🎯 SENSOR CALIBRATION");
  Serial.println("Taking 10 calibration readings...");
  
  float calibrationReadings[10];
  int validReadings = 0;
  
  for (int i = 0; i < 10; i++) {
    float reading = takeSingleReading();
    if (reading > 0 && reading < MAX_VALID_DISTANCE) {
      calibrationReadings[validReadings] = reading;
      validReadings++;
      Serial.println("  Reading " + String(i+1) + ": " + String(reading, 2) + "cm ✅");
    } else {
      Serial.println("  Reading " + String(i+1) + ": Invalid ❌");
    }
    delay(300);
  }
  
  if (validReadings >= 5) {
    // Calculate average and stability
    float sum = 0;
    for (int i = 0; i < validReadings; i++) {
      sum += calibrationReadings[i];
    }
    float average = sum / validReadings;
    
    // Calculate variance
    float variance = 0;
    for (int i = 0; i < validReadings; i++) {
      variance += pow(calibrationReadings[i] - average, 2);
    }
    variance /= validReadings;
    float stdDev = sqrt(variance);
    
    Serial.println("📊 Calibration Results:");
    Serial.println("  ✅ Valid readings: " + String(validReadings) + "/10");
    Serial.println("  📏 Average distance: " + String(average, 2) + "cm");
    Serial.println("  📊 Standard deviation: " + String(stdDev, 2) + "cm");
    
    if (stdDev < 0.5) {
      Serial.println("  🎯 EXCELLENT accuracy (±" + String(stdDev, 2) + "cm)");
      accuracy_status = "EXCELLENT";
    } else if (stdDev < 1.0) {
      Serial.println("  ✅ GOOD accuracy (±" + String(stdDev, 2) + "cm)");
      accuracy_status = "GOOD";
    } else {
      Serial.println("  ⚠️  MODERATE accuracy (±" + String(stdDev, 2) + "cm)");
      accuracy_status = "MODERATE";
    }
    
    lastStableReading = average;
    readingStabilized = true;
  } else {
    Serial.println("❌ Calibration failed - insufficient valid readings");
    accuracy_status = "POOR";
  }
}

float takeSingleReading() {
  // Clear trigger
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(5);
  
  // Send pulse
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  
  // Read echo with timeout
  long duration = pulseIn(ECHO_PIN, HIGH, SENSOR_TIMEOUT);
  
  if (duration == 0) {
    return -1; // Timeout
  }
  
  // Calculate distance
  float distance = (duration * 0.0343) / 2;
  
  // Validate range
  if (distance < MIN_VALID_DISTANCE || distance > MAX_VALID_DISTANCE) {
    return -1; // Out of range
  }
  
  return distance;
}

void readBinLevelAccurate() {
  // Take multiple readings for accuracy
  float readings[READINGS_COUNT];
  int validReadings = 0;
  
  for (int i = 0; i < READINGS_COUNT; i++) {
    float reading = takeSingleReading();
    if (reading > 0) {
      readings[validReadings] = reading;
      validReadings++;
    }
    delay(50); // Small delay between readings
  }
  
  if (validReadings == 0) {
    sensorWorking = false;
    bin_status = "SENSOR_ERROR";
    fill_level = "UNKNOWN";
    accuracy_status = "ERROR";
    return;
  }
  
  sensorWorking = true;
  
  // Calculate median for noise rejection
  if (validReadings >= 3) {
    // Sort readings
    for (int i = 0; i < validReadings - 1; i++) {
      for (int j = i + 1; j < validReadings; j++) {
        if (readings[i] > readings[j]) {
          float temp = readings[i];
          readings[i] = readings[j];
          readings[j] = temp;
        }
      }
    }
    // Use median
    distance_cm = readings[validReadings / 2];
  } else {
    // Use average if few readings
    float sum = 0;
    for (int i = 0; i < validReadings; i++) {
      sum += readings[i];
    }
    distance_cm = sum / validReadings;
  }
  
  // ULTRA-PRECISE FILL CALCULATION
  // Calculate actual waste height
  waste_height_cm = SENSOR_TO_BIN_BOTTOM - distance_cm;
  
  // Ensure within physical limits
  if (waste_height_cm < 0) waste_height_cm = 0;
  if (waste_height_cm > BIN_HEIGHT_CM) waste_height_cm = BIN_HEIGHT_CM;
  
  // Calculate precise percentage
  fill_percentage = (waste_height_cm / BIN_HEIGHT_CM) * 100.0;
  
  // Ensure 0-100% range
  if (fill_percentage < 0) fill_percentage = 0;
  if (fill_percentage > 100) fill_percentage = 100;
  
  // Round to 0.1% precision
  fill_percentage = round(fill_percentage * 10.0) / 10.0;
  
  // Update reading stability
  if (readingStabilized) {
    float difference = abs(distance_cm - lastStableReading);
    if (difference < 0.5) {
      consecutiveGoodReadings++;
    } else {
      consecutiveGoodReadings = 0;
    }
    lastStableReading = distance_cm;
  }
}

void updateBinStatusAccurate() {
  if (!sensorWorking) {
    bin_status = "SENSOR_ERROR";
    fill_level = "UNKNOWN";
    bin_full_alert = false;
    bin_critical_alert = false;
    return;
  }
  
  // ENHANCED STATUS DETERMINATION
  if (fill_percentage >= CRITICAL_FULL_THRESHOLD) {
    fill_level = "CRITICAL";
    bin_status = "CRITICAL_FULL";
    bin_full_alert = true;
    bin_critical_alert = true;
  } else if (fill_percentage >= FULL_THRESHOLD) {
    fill_level = "FULL";
    bin_status = "FULL";  // Garbage near top of bin
    bin_full_alert = true;
    bin_critical_alert = false;
  } else if (fill_percentage >= HIGH_THRESHOLD) {
    fill_level = "HIGH";
    bin_status = "ALMOST_FULL";
    bin_full_alert = false;
    bin_critical_alert = false;
  } else if (fill_percentage >= MEDIUM_THRESHOLD) {
    fill_level = "MEDIUM";
    bin_status = "HALF_FULL";
    bin_full_alert = false;
    bin_critical_alert = false;
  } else if (fill_percentage >= LOW_THRESHOLD) {
    fill_level = "LOW";
    bin_status = "QUARTER_FULL";
    bin_full_alert = false;
    bin_critical_alert = false;
  } else if (fill_percentage >= EMPTY_THRESHOLD) {
    fill_level = "VERY_LOW";
    bin_status = "NEARLY_EMPTY";
    bin_full_alert = false;
    bin_critical_alert = false;
  } else {
    fill_level = "EMPTY";
    bin_status = "EMPTY";
    bin_full_alert = false;
    bin_critical_alert = false;
  }
}

void trackStateTransitions() {
  // Track empty state transitions
  bool isCurrentlyEmpty = (fill_percentage <= EMPTY_THRESHOLD);
  if (isCurrentlyEmpty && !wasEmpty) {
    lastEmptyTime = millis();
    wasEmpty = true;
    Serial.println("🗑️  TRANSITION: Bin became EMPTY - " + getCurrentTimestamp());
  } else if (!isCurrentlyEmpty && wasEmpty) {
    wasEmpty = false;
    Serial.println("📈 TRANSITION: Bin no longer empty (" + String(fill_percentage, 1) + "%)");
  }
  
  // Track full state transitions
  bool isCurrentlyFull = (fill_percentage >= FULL_THRESHOLD);
  if (isCurrentlyFull && !wasFull) {
    lastFullTime = millis();
    wasFull = true;
    Serial.println("🚨 TRANSITION: Bin became FULL - " + getCurrentTimestamp());
  } else if (!isCurrentlyFull && wasFull) {
    wasFull = false;
    Serial.println("📉 TRANSITION: Bin no longer full (" + String(fill_percentage, 1) + "%)");
  }
  
  // Track critical state transitions
  bool isCurrentlyCritical = (fill_percentage >= CRITICAL_FULL_THRESHOLD);
  if (isCurrentlyCritical && !wasCritical) {
    lastCriticalTime = millis();
    wasCritical = true;
    Serial.println("🔴 TRANSITION: Bin became CRITICAL - " + getCurrentTimestamp());
  } else if (!isCurrentlyCritical && wasCritical) {
    wasCritical = false;
    Serial.println("🟠 TRANSITION: Bin no longer critical (" + String(fill_percentage, 1) + "%)");
  }
}

