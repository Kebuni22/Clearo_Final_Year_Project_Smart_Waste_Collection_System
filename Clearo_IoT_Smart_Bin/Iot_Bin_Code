  doc["fields"]["data_count"]["integerValue"] = String(dataCounter);
  doc["fields"]["uptime_hours"]["doubleValue"] = deviceUptime / 3600000.0;
  
  // Ultra-precise fill data
  doc["fields"]["fill_data"]["mapValue"]["fields"]["distance_cm"]["doubleValue"] = round(distance_cm * 10) / 10.0;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["waste_height_cm"]["doubleValue"] = round(waste_height_cm * 10) / 10.0;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["fill_percentage"]["doubleValue"] = fill_percentage;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["bin_status"]["stringValue"] = bin_status;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["fill_level"]["stringValue"] = fill_level;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["bin_height_cm"]["doubleValue"] = BIN_HEIGHT_CM;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["sensor_height_cm"]["doubleValue"] = SENSOR_HEIGHT_FROM_TOP_CM;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["is_full"]["booleanValue"] = bin_full_alert;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["is_critical"]["booleanValue"] = bin_critical_alert;
  doc["fields"]["fill_data"]["mapValue"]["fields"]["needs_emptying"]["booleanValue"] = (fill_percentage >= FULL_THRESHOLD);
  doc["fields"]["fill_data"]["mapValue"]["fields"]["needs_urgent_attention"]["booleanValue"] = (fill_percentage >= CRITICAL_FULL_THRESHOLD);
  
  // Accuracy and quality metrics
  doc["fields"]["accuracy"]["mapValue"]["fields"]["status"]["stringValue"] = accuracy_status;
  doc["fields"]["accuracy"]["mapValue"]["fields"]["consecutive_good_readings"]["integerValue"] = String(consecutiveGoodReadings);
  doc["fields"]["accuracy"]["mapValue"]["fields"]["reading_stabilized"]["booleanValue"] = readingStabilized;
  doc["fields"]["accuracy"]["mapValue"]["fields"]["samples_per_reading"]["integerValue"] = String(READINGS_COUNT);
  
  // Enhanced last empty tracking
  if (lastEmptyTime > 0) {
    String lastEmptyISO = timestampToISO(lastEmptyTime);
    double hoursSinceEmpty = (millis() - lastEmptyTime) / 3600000.0;
    double daysSinceEmpty = hoursSinceEmpty / 24.0;
    
    doc["fields"]["last_empty"]["mapValue"]["fields"]["timestamp"]["timestampValue"] = lastEmptyISO;
    doc["fields"]["last_empty"]["mapValue"]["fields"]["readable_time"]["stringValue"] = timestampToReadable(lastEmptyTime);
    doc["fields"]["last_empty"]["mapValue"]["fields"]["hours_ago"]["doubleValue"] = round(hoursSinceEmpty * 10) / 10.0;
    doc["fields"]["last_empty"]["mapValue"]["fields"]["days_ago"]["doubleValue"] = round(daysSinceEmpty * 100) / 100.0;
    doc["fields"]["last_empty"]["mapValue"]["fields"]["currently_empty"]["booleanValue"] = wasEmpty;
  } else {
    doc["fields"]["last_empty"]["mapValue"]["fields"]["timestamp"]["nullValue"] = nullptr;
    doc["fields"]["last_empty"]["mapValue"]["fields"]["readable_time"]["stringValue"] = "Never recorded";
    doc["fields"]["last_empty"]["mapValue"]["fields"]["hours_ago"]["doubleValue"] = 0.0;
    doc["fields"]["last_empty"]["mapValue"]["fields"]["days_ago"]["doubleValue"] = 0.0;
    doc["fields"]["last_empty"]["mapValue"]["fields"]["currently_empty"]["booleanValue"] = wasEmpty;
  }
  
  // Collection analytics
  if (lastFullTime > 0) {
    doc["fields"]["collection"]["mapValue"]["fields"]["last_full_time"]["timestampValue"] = timestampToISO(lastFullTime);
    doc["fields"]["collection"]["mapValue"]["fields"]["last_full_readable"]["stringValue"] = timestampToReadable(lastFullTime);
    
    if (lastEmptyTime > 0 && lastFullTime > lastEmptyTime) {
      double fillTimeHours = (lastFullTime - lastEmptyTime) / 3600000.0;
      doc["fields"]["collection"]["mapValue"]["fields"]["time_to_fill_hours"]["doubleValue"] = round(fillTimeHours * 10) / 10.0;
      doc["fields"]["collection"]["mapValue"]["fields"]["fill_rate_percent_per_hour"]["doubleValue"] = round((100.0 / fillTimeHours) * 10) / 10.0;
    }
  }
  
  if (lastCriticalTime > 0) {
    doc["fields"]["collection"]["mapValue"]["fields"]["last_critical_time"]["timestampValue"] = timestampToISO(lastCriticalTime);
    doc["fields"]["collection"]["mapValue"]["fields"]["last_critical_readable"]["stringValue"] = timestampToReadable(lastCriticalTime);
  }
  
  // Location data
  if (gpsFixed) {
    doc["fields"]["location_data"]["mapValue"]["fields"]["status"]["stringValue"] = "fixed";
    doc["fields"]["location_data"]["mapValue"]["fields"]["latitude"]["doubleValue"] = latitude;
    doc["fields"]["location_data"]["mapValue"]["fields"]["longitude"]["doubleValue"] = longitude;
    doc["fields"]["location_data"]["mapValue"]["fields"]["satellites"]["integerValue"] = String(satellites);
    if (altitude_m != 0) {
      doc["fields"]["location_data"]["mapValue"]["fields"]["altitude_m"]["doubleValue"] = altitude_m;
    }
  } else {
    doc["fields"]["location_data"]["mapValue"]["fields"]["status"]["stringValue"] = "searching";
  }
  
  // System health and diagnostics
  doc["fields"]["system"]["mapValue"]["fields"]["sensor_working"]["booleanValue"] = sensorWorking;
  doc["fields"]["system"]["mapValue"]["fields"]["wifi_connected"]["booleanValue"] = wifiConnected;
  doc["fields"]["system"]["mapValue"]["fields"]["wifi_rssi"]["integerValue"] = String(WiFi.RSSI());
  doc["fields"]["system"]["mapValue"]["fields"]["free_memory_bytes"]["integerValue"] = String(ESP.getFreeHeap());
  doc["fields"]["system"]["mapValue"]["fields"]["last_update"]["timestampValue"] = iso_timestamp;
  doc["fields"]["system"]["mapValue"]["fields"]["firmware_version"]["stringValue"] = "v2.0_ultra_accurate";
  
  // Thresholds for reference
  doc["fields"]["thresholds"]["mapValue"]["fields"]["empty_threshold"]["doubleValue"] = EMPTY_THRESHOLD;
  doc["fields"]["thresholds"]["mapValue"]["fields"]["low_threshold"]["doubleValue"] = LOW_THRESHOLD;
  doc["fields"]["thresholds"]["mapValue"]["fields"]["medium_threshold"]["doubleValue"] = MEDIUM_THRESHOLD;
  doc["fields"]["thresholds"]["mapValue"]["fields"]["high_threshold"]["doubleValue"] = HIGH_THRESHOLD;
  doc["fields"]["thresholds"]["mapValue"]["fields"]["full_threshold"]["doubleValue"] = FULL_THRESHOLD;
  doc["fields"]["thresholds"]["mapValue"]["fields"]["critical_threshold"]["doubleValue"] = CRITICAL_FULL_THRESHOLD;
  
  String jsonString;
  serializeJson(doc, jsonString);
  
  Serial.print("🔥 Sending Ultra-Accurate Data #" + String(dataCounter) + " to Firestore ");
  
  // Update main bin document
  String binDocUrl = "https://firestore.googleapis.com/v1/projects/" + String(project_id) + 
                     "/databases/(default)/documents/" + String(bins_collection) + "/" + String(bin_id) + 
                     "?key=" + String(firestore_api_key);
  
  http.begin(client, binDocUrl);
  http.addHeader("Content-Type", "application/json");
  
  int statusCode = http.PATCH(jsonString);
  if (statusCode > 0) {
    Serial.print("✅(" + String(statusCode) + ") ");
    if (statusCode == 404) {
      statusCode = http.PUT(jsonString);
      Serial.print("Created(" + String(statusCode) + ") ");
    }
  } else {
    Serial.print("❌(" + String(statusCode) + ") ");
  }
  http.end();
  
  // Enhanced history logging (every 3rd reading or significant changes)
  bool shouldLogHistory = (dataCounter % 3 == 0) || bin_full_alert || bin_critical_alert || 
                         (abs(fill_percentage - 50.0) < 2.0) || // Log around 50%
                         (fill_percentage >= 80.0);             // Log high levels more frequently
  
  if (shouldLogHistory) {
    DynamicJsonDocument historyDoc(3072);
    historyDoc["fields"]["bin_id"]["stringValue"] = bin_id;
    historyDoc["fields"]["timestamp"]["timestampValue"] = iso_timestamp;
    historyDoc["fields"]["fill_percentage"]["doubleValue"] = fill_percentage;
    historyDoc["fields"]["waste_height_cm"]["doubleValue"] = waste_height_cm;
    historyDoc["fields"]["distance_cm"]["doubleValue"] = distance_cm;
    historyDoc["fields"]["bin_status"]["stringValue"] = bin_status;
    historyDoc["fields"]["fill_level"]["stringValue"] = fill_level;
    historyDoc["fields"]["data_count"]["integerValue"] = String(dataCounter);
    historyDoc["fields"]["accuracy_status"]["stringValue"] = accuracy_status;
    historyDoc["fields"]["is_full"]["booleanValue"] = bin_full_alert;
    historyDoc["fields"]["is_critical"]["booleanValue"] = bin_critical_alert;
    
    // Include time since last empty
    if (lastEmptyTime > 0) {
      double hoursSinceEmpty = (millis() - lastEmptyTime) / 3600000.0;
      historyDoc["fields"]["hours_since_empty"]["doubleValue"] = round(hoursSinceEmpty * 10) / 10.0;
    }
    
    String historyJson;
    serializeJson(historyDoc, historyJson);
    
    String historyUrl = "https://firestore.googleapis.com/v1/projects/" + String(project_id) + 
                        "/databases/(default)/documents/" + String(history_collection) + 
                        "?key=" + String(firestore_api_key);
    
    http.begin(client, historyUrl);
    http.addHeader("Content-Type", "application/json");
    
    int historyCode = http.POST(historyJson);
    Serial.print(historyCode > 0 ? "📚✅(" + String(historyCode) + ") " : "📚❌(" + String(historyCode) + ") ");
    http.end();
  }
  
  // Enhanced alerting system
  if ((bin_full_alert || bin_critical_alert) && !alertSent) {
    DynamicJsonDocument alertDoc(2560);
    alertDoc["fields"]["bin_id"]["stringValue"] = bin_id;
    alertDoc["fields"]["alert_type"]["stringValue"] = bin_critical_alert ? "BIN_CRITICAL" : "BIN_FULL";
    alertDoc["fields"]["timestamp"]["timestampValue"] = iso_timestamp;
    alertDoc["fields"]["fill_percentage"]["doubleValue"] = fill_percentage;
    alertDoc["fields"]["waste_height_cm"]["doubleValue"] = waste_height_cm;
    alertDoc["fields"]["location"]["stringValue"] = location_name;
    alertDoc["fields"]["priority"]["stringValue"] = bin_critical_alert ? "URGENT" : "HIGH";
    
    String alertMessage = "Smart bin " + String(bin_id) + " is " + String(fill_percentage, 1) + "% full";
    if (bin_critical_alert) {
      alertMessage += " - CRITICAL: Overflow imminent!";
    } else {
      alertMessage += " - Garbage near top of bin!";
    }
    alertDoc["fields"]["message"]["stringValue"] = alertMessage;
    alertDoc["fields"]["resolved"]["booleanValue"] = false;
    
    // Enhanced alert data
    alertDoc["fields"]["bin_height_cm"]["doubleValue"] = BIN_HEIGHT_CM;
    alertDoc["fields"]["distance_to_waste_cm"]["doubleValue"] = distance_cm;
    alertDoc["fields"]["accuracy_status"]["stringValue"] = accuracy_status;
    
    if (lastEmptyTime > 0) {
      double hoursSinceEmpty = (millis() - lastEmptyTime) / 3600000.0;
      alertDoc["fields"]["hours_since_empty"]["doubleValue"] = round(hoursSinceEmpty * 10) / 10.0;
      alertDoc["fields"]["last_empty_time"]["timestampValue"] = timestampToISO(lastEmptyTime);
    }
    
    // GPS coordinates for collection routing
    if (gpsFixed) {
      alertDoc["fields"]["coordinates"]["mapValue"]["fields"]["latitude"]["doubleValue"] = latitude;
      alertDoc["fields"]["coordinates"]["mapValue"]["fields"]["longitude"]["doubleValue"] = longitude;
    }
    
    String alertJson;
    serializeJson(alertDoc, alertJson);
    
    String alertUrl = "https://firestore.googleapis.com/v1/projects/" + String(project_id) + 
                      "/databases/(default)/documents/" + String(alerts_collection) + 
                      "?key=" + String(firestore_api_key);
    
    http.begin(client, alertUrl);
    http.addHeader("Content-Type", "application/json");
    
    int alertCode = http.POST(alertJson);
    Serial.print(alertCode > 0 ? "🚨✅(" + String(alertCode) + ") " : "🚨❌(" + String(alertCode) + ") ");
    http.end();
  }
  
  Serial.println();
  
  // Ultra-detailed status summary
  Serial.print("📊 SUMMARY: " + String(fill_percentage, 1) + "% ");
  Serial.print("[" + bin_status + "] ");
  Serial.print("H:" + String(waste_height_cm, 1) + "cm ");
  Serial.print("D:" + String(distance_cm, 1) + "cm ");
  Serial.print("Acc:" + accuracy_status + " ");
  Serial.print("Sensor:" + String(sensorWorking ? "✅" : "❌") + " ");
  Serial.print("WiFi:" + String(wifiConnected ? "✅" : "❌") + " ");
  Serial.print("GPS:" + String(gpsFixed ? "✅" : "🔍"));
  
  // Show time information
  if (lastEmptyTime > 0) {
    double hoursSinceEmpty = (millis() - lastEmptyTime) / 3600000.0;
    if (hoursSinceEmpty < 1.0) {
      Serial.print(" Empty:" + String(int(hoursSinceEmpty * 60)) + "m");
    } else if (hoursSinceEmpty < 24.0) {
      Serial.print(" Empty:" + String(hoursSinceEmpty, 1) + "h");
    } else {
      Serial.print(" Empty:" + String(hoursSinceEmpty / 24.0, 1) + "d");
    }
  }
  
  // Alert status
  if (bin_critical_alert) Serial.print(" 🔴CRITICAL");
  else if (bin_full_alert) Serial.print(" 🟠FULL");
  
  Serial.println();
  Serial.println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
}

// ==================== UTILITY FUNCTIONS ====================
String getFormattedTime() {
  unsigned long totalSeconds = deviceUptime / 1000;
  int hours = totalSeconds / 3600;
  int minutes = (totalSeconds % 3600) / 60;
  int seconds = totalSeconds % 60;
  
  char timeBuffer[20];
  sprintf(timeBuffer, "%02d:%02d:%02d", hours, minutes, seconds);
  return String(timeBuffer);
}

String getCurrentTimestamp() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    // Fallback timestamp
    return "2024-" + String(month()) + "-" + String(day()) + " " + getFormattedTime();
  }
  
  char timeStringBuff[50];
  strftime(timeStringBuff, sizeof(timeStringBuff), "%Y-%m-%d %H:%M:%S", &timeinfo);
  return String(timeStringBuff);
}

String getCurrentISOTimestamp() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    unsigned long epochTime = millis() / 1000 + 1640995200;
    return timestampToISO(epochTime * 1000);
  }
  
  char timeStringBuff[30];
  strftime(timeStringBuff, sizeof(timeStringBuff), "%Y-%m-%dT%H:%M:%SZ", &timeinfo);
  return String(timeStringBuff);
}

String timestampToISO(unsigned long timestamp_ms) {
  time_t timestamp_sec = timestamp_ms / 1000;
  struct tm* timeinfo = gmtime(&timestamp_sec);
  
  char timeStringBuff[30];
  strftime(timeStringBuff, sizeof(timeStringBuff), "%Y-%m-%dT%H:%M:%SZ", timeinfo);
  return String(timeStringBuff);
}

String timestampToReadable(unsigned long timestamp_ms) {
  time_t timestamp_sec = timestamp_ms / 1000;
  struct tm* timeinfo = localtime(&timestamp_sec);
  
  char timeStringBuff[50];
  strftime(timeStringBuff, sizeof(timeStringBuff), "%Y-%m-%d %H:%M:%S", timeinfo);
  return String(timeStringBuff);
}

// Helper function for month/day (if needed)
int month() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return 1;
  return timeinfo.tm_mon + 1;
}

int day() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return 1;
  return timeinfo.tm_mday;
}